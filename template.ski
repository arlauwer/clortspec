                <samplingOptions type="SamplingOptions">
                    <SamplingOptions numDensitySamples="100" numPropertySamples="1" aggregateVelocity="Average"/>
                </samplingOptions>

                <grid type="SpatialGrid">
                    <Sphere3DSpatialGrid minRadius="{minRadius}" maxRadius="{maxRadius}">
                        <meshRadial type="Mesh">
                            <LogMesh numBins="100" centralBinFraction="1e-3"/>
                        </meshRadial>
                        <meshPolar type="Mesh">
                            <ListMesh points="{polarMeshPoints}"/>
                        </meshPolar>
						<meshAzimuthal type="Mesh">
							<LinMesh numBins="3"/>
						</meshAzimuthal>
                    </Sphere3DSpatialGrid>
                </grid>

            </MediumSystem>
        </mediumSystem>
        <instrumentSystem type="InstrumentSystem">
            <InstrumentSystem>

                <defaultWavelengthGrid type="WavelengthGrid">
                    <LogWavelengthGrid minWavelength="10 keV" maxWavelength="0.3 keV" numWavelengths="100"/>
                </defaultWavelengthGrid>

                <instruments type="Instrument">

                    <SEDInstrument instrumentName="i00" distance="1 Mpc" inclination="00 deg" azimuth="0 deg" roll="0 deg" radius="0 pc" recordComponents="true" numScatteringLevels="0" recordPolarization="false" recordStatistics="false"/>
					<SEDInstrument instrumentName="i90" distance="1 Mpc" inclination="90 deg" azimuth="0 deg" roll="0 deg" radius="0 pc" recordComponents="true" numScatteringLevels="0" recordPolarization="false" recordStatistics="false"/>

                </instruments>
            </InstrumentSystem>
        </instrumentSystem>
        <probeSystem type="ProbeSystem">
            <ProbeSystem>
                <probes type="Probe">

                    <ConvergenceInfoProbe probeName="conv" wavelength="7.2 keV" probeAfter="Setup"/>

					<OpacityProbe probeName="opacity" probeAfter="Setup">
						<wavelengthGrid type="WavelengthGrid">
							<LogWavelengthGrid minWavelength="10 keV" maxWavelength="0.3 keV" numWavelengths="400"/>
						</wavelengthGrid>
						<form type="Form">
							<!-- <ParallelProjectionForm inclination="90 deg" azimuth="0 deg" roll="0 deg" fieldOfViewX="1e18 cm" numPixelsX="1" fieldOfViewY="1e18 cm" numPixelsY="1"/> -->
							<PerCellForm/>
						</form>
					</OpacityProbe>

					<TemperatureProbe probeName="temperature" probeAfter="Setup">
						<form type="Form">
							<PerCellForm/>
						</form>
					</TemperatureProbe>

					<SpatialCellPropertiesProbe probeName="prop" wavelength="7.2 keV" probeAfter="Setup">

                </probes>
            </ProbeSystem>
